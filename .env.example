# ---- Admin login (CHANGE THESE!) ----
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-this-to-a-strong-password

# Long random string used to sign login sessions.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# How long an admin login lasts (hours)
SESSION_HOURS=12

# ---- Server ----
PORT=3000
HOST=0.0.0.0
MAX_UPLOAD_MB=8

# ---- Storage ----
# Postgres database (recommended when deployed). When set, ALL admin saves, contact messages and
# uploaded photos are stored in the database, so they survive redeploys and restarts.
# Antideploy / Render / Railway / Neon set DATABASE_URL for you automatically.
# DATABASE_URL=postgres://user:password@host:5432/dbname
# Force SSL for the database connection (only if your provider needs it and the URL has no sslmode):
# DATABASE_SSL=true

# Without DATABASE_URL, everything is stored as files here (fine for local development,
# or point them at a persistent disk):
# DATA_DIR=./data
# UPLOAD_DIR=./uploads
