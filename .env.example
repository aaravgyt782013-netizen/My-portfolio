# ---- Admin login (CHANGE THESE!) ----
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-this-to-a-strong-password

# Long random string used to sign login sessions.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# How long an admin login lasts (hours)
SESSION_HOURS=12

# ---- Server ----
PORT=3000
HOST=0.0.0.0
MAX_UPLOAD_MB=8

# Optional: where content/messages and uploaded files are stored
# (point these at a persistent disk when deploying, e.g. on Render/Railway)
# DATA_DIR=./data
# UPLOAD_DIR=./uploads
